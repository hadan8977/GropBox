# Canonical URL. Use HTTPS for the deployed site.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: use a Supabase secret key or the legacy service_role key.
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated by npm run setup. Keep stable across deployments; never rotate on redeploy.
TOKEN_ENCRYPTION_KEY=
# Generated independently by npm run setup. Protects the daily archive cron.
CRON_SECRET=
# Optional: comma-separated Google email allowlist for a private deployment.
ALLOWED_GOOGLE_EMAILS=

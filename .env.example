# Canonical URL. Use HTTPS for the deployed site.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: use a Supabase secret key or the legacy service_role key.
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only: 64 hexadecimal characters (32 random bytes). Keep stable across deployments.
TOKEN_ENCRYPTION_KEY=
# Protect the daily archive cron; use a separate random secret.
CRON_SECRET=
# Optional: comma-separated Google email allowlist for a private deployment.
ALLOWED_GOOGLE_EMAILS=
